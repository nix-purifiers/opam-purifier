opam-version: "2.0"
name: "alpha"
version: "0.2.0"
synopsis: "A fixture for opam-purifier: a library on a git pin"
maintainer: "nix-purifiers"
authors: "nix-purifiers"
license: "MIT"
homepage: "https://github.com/nix-purifiers/opam-purifier"
bug-reports: "https://github.com/nix-purifiers/opam-purifier/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "base64"
]
pin-depends: [
  ["base64.3.5.1" "git+https://github.com/mirage/ocaml-base64.git#v3.5.1"]
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
