opam-version: "2.0"
name: "hello"
version: "0.1.0"
synopsis: "A fixture for opam-purifier: an executable and a library"
maintainer: "nix-purifiers"
authors: "nix-purifiers"
license: "MIT"
homepage: "https://github.com/nix-purifiers/opam-purifier"
bug-reports: "https://github.com/nix-purifiers/opam-purifier/issues"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.24.2"}
  "fmt" {= "0.11.0"}
  "ocaml" {= "5.2.1"}
  "ocaml-base-compiler" {= "5.2.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "topkg" {= "1.1.1"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]