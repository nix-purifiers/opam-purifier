#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
#
# opam-purifier: locks every file an opam project downloads, so that Nix
# can build the project offline in its sandbox.
#
#   opam-purifier lock       solve the project and record every download
#   opam-purifier prefetch   realize what the everyday loop and the editor
#                            need, and set up the local switch _opam
#   opam-purifier publish    build the release archive with Nix and submit
#                            the opam files that point at it
#
# The commands run in the project root, where the project's opam files
# are, and each takes --lockfile PATH for a lockfile outside it. The
# package that installs this script sets OPAM_PURIFIER_LIB (the Nix
# library), OPAM_PURIFIER_NIXPKGS (the nixpkgs it builds with) and
# OPAM_PURIFIER_PURIFIER (the source of the purifier library).

import argparse
import base64
import hashlib
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

LOCK_FILE = "opam-purifier.lock.json"
# The package the lock run makes to solve the tools (--tool) together
# with the project.
TOOLS_PACKAGE = "opam-purifier-tools"
LOCK_VERSION = 1
STATE_DIR = ".opam-purifier"
DEFAULT_REPOSITORY = ("default", "https://opam.ocaml.org")
OPAM_CACHE = "https://opam.ocaml.org/cache"

# The Nix systems a lock covers, with the value of opam's `arch` variable
# on each.
SYSTEMS = {
    "x86_64-linux": "x86_64",
    "aarch64-linux": "arm64",
}


def platform_env(system):
    """opam's platform variables for a Nix system. The lock run and the
    sandboxed build set the same values, so that the `available` fields
    and the depexts evaluate the same way in both. NixOS is the
    distribution whose depexts name nixpkgs attributes."""
    return {
        "OPAMVAR_arch": SYSTEMS[system],
        "OPAMVAR_os": "linux",
        "OPAMVAR_os_family": "nixos",
        "OPAMVAR_os_distribution": "nixos",
    }


def fail(message):
    print(f"opam-purifier: {message}", file=sys.stderr)
    sys.exit(1)


def run(cmd, env=None, cwd=None, capture=False):
    try:
        result = subprocess.run(
            cmd,
            env=env,
            cwd=cwd,
            check=False,
            stdout=subprocess.PIPE if capture else None,
            text=True,
        )
    except FileNotFoundError:
        fail(f"could not run {cmd[0]}; it is not on PATH")
    if result.returncode != 0:
        fail(f"{' '.join(cmd)} failed")
    return result.stdout if capture else None


def sri_sha256(data):
    return "sha256-" + base64.b64encode(hashlib.sha256(data).digest()).decode()


# ---------------------------------------------------------------------------
# The opam file format, as far as the lock reads it: fields, sections, and
# the values inside them (strings, lists, groups, options and bare tokens).
# The grammar follows the opam-file-format library. Filters and operators
# stay tokens, because the lock never evaluates them.

TOKEN = re.compile(
    r"""
    (?P<ws>\s+)
  | (?P<comment>\#[^\n]*)
  | (?P<block>\(\*.*?\*\))
  | (?P<triple>""\"(?:.|\n)*?""\")
  | (?P<string>"(?:\\.|[^"\\])*")
  | (?P<punct>[\[\]{}():])
  | (?P<op>!=|<=|>=|\+=|=\+|:=|[=<>~&|!?+])
  | (?P<word>[^\s\[\]{}():"#=<>~&|!?+]+)
    """,
    re.VERBOSE | re.DOTALL,
)

ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "\\": "\\", '"': '"', "\n": ""}
BRACKETS = {"[": ("]", "list"), "(": (")", "group"), "{": ("}", "option")}


def unescape(body):
    out = []
    i = 0
    while i < len(body):
        c = body[i]
        if c == "\\" and i + 1 < len(body):
            nxt = body[i + 1]
            if nxt in ESCAPES:
                out.append(ESCAPES[nxt])
                i += 2
                if nxt == "\n":
                    while i < len(body) and body[i] in " \t":
                        i += 1
                continue
            if nxt.isdigit() and i + 3 < len(body):
                out.append(chr(int(body[i + 1 : i + 4])))
                i += 4
                continue
            if nxt == "x" and i + 3 < len(body):
                out.append(chr(int(body[i + 2 : i + 4], 16)))
                i += 4
                continue
        out.append(c)
        i += 1
    return "".join(out)


def tokenize(text):
    tokens = []
    pos = 0
    while pos < len(text):
        m = TOKEN.match(text, pos)
        if not m:
            raise ValueError(f"cannot read opam file at offset {pos}")
        pos = m.end()
        kind = m.lastgroup
        if kind in ("ws", "comment", "block"):
            continue
        value = m.group(kind)
        if kind == "triple":
            tokens.append(("str", unescape(value[3:-3])))
        elif kind == "string":
            tokens.append(("str", unescape(value[1:-1])))
        elif kind == "punct":
            tokens.append((value, value))
        else:
            tokens.append(("tok", value))
    return tokens


class OpamFile:
    """The fields and sections of an opam file."""

    def __init__(self, text):
        self.tokens = tokenize(text)
        self.pos = 0
        self.fields, self.sections = self.items(top=True)

    def peek(self, n=0):
        i = self.pos + n
        return self.tokens[i] if i < len(self.tokens) else (None, None)

    def take(self):
        tok = self.peek()
        self.pos += 1
        return tok

    def at_item(self):
        """Whether the next tokens start a field (`name:`) or a section
        (`name {` or `name "label" {`)."""
        kind, _ = self.peek()
        if kind != "tok":
            return False
        k1, _ = self.peek(1)
        if k1 in (":", "{"):
            return True
        k2, _ = self.peek(2)
        return k1 == "str" and k2 == "{"

    def items(self, top):
        fields = {}
        sections = []
        while True:
            kind, value = self.peek()
            if kind is None:
                if not top:
                    raise ValueError("unclosed section")
                return fields, sections
            if kind == "}" and not top:
                self.take()
                return fields, sections
            if not self.at_item():
                raise ValueError(f"expected a field, found {value!r}")
            _, name = self.take()
            kind, _ = self.peek()
            if kind == ":":
                self.take()
                fields[name] = self.values(stop_at_items=True)
            else:
                label = None
                if kind == "str":
                    _, label = self.take()
                self.take()
                sub_fields, sub_sections = self.items(top=False)
                sections.append((name, label, sub_fields, sub_sections))

    def values(self, stop_at_items=False, closer=None):
        values = []
        while True:
            kind, value = self.peek()
            if kind is None:
                if closer:
                    raise ValueError(f"missing {closer}")
                return values
            if closer and kind == closer:
                self.take()
                return values
            if stop_at_items and (kind == "}" or self.at_item()):
                return values
            self.take()
            if kind in BRACKETS:
                close, label = BRACKETS[kind]
                values.append((label, self.values(closer=close)))
            else:
                values.append((kind, value))

    def string(self, name):
        for kind, value in self.fields.get(name, []):
            if kind == "str":
                return value
        return None


def strings_of(values):
    """The strings of a field value: a single string, or a list of them."""
    out = []
    for kind, value in values:
        if kind == "str":
            out.append(value)
        elif kind == "list":
            out.extend(strings_of(value))
    return out


def sources_of(text):
    """The downloads an opam file declares, from its url section and its
    extra-source sections."""
    opam = OpamFile(text)
    sources = []
    for kind, label, fields, _ in opam.sections:
        if kind not in ("url", "extra-source"):
            continue
        src = strings_of(fields.get("src", []) or fields.get("archive", []))
        if not src:
            continue
        sources.append(
            {
                "name": label,
                "src": src[0],
                "checksums": strings_of(fields.get("checksum", [])),
                "mirrors": strings_of(fields.get("mirrors", [])),
            }
        )
    return sources


def pin_depends_of(text):
    """The pin-depends of an opam file, as (package, url) pairs."""
    pairs = []

    def walk(values):
        strs = [v for k, v in values if k == "str"]
        lists = [v for k, v in values if k == "list"]
        if len(strs) == 2 and not lists:
            pairs.append((strs[0], strs[1]))
        for inner in lists:
            walk(inner)

    walk(OpamFile(text).fields.get("pin-depends", []))
    return pairs


# ---------------------------------------------------------------------------
# URLs. An opam source URL names its transport: `git+https://...#ref`,
# `hg+https://...`, a plain `https://...` archive, or a `file://` path.


def vcs_of(url):
    if url.startswith("git+") or url.startswith("git://"):
        return "git"
    if url.startswith("hg+"):
        return "hg"
    if url.startswith("darcs+"):
        return "darcs"
    if url.split("#", 1)[0].endswith(".git"):
        return "git"
    return None


def split_vcs(url):
    """The fetch URL and the ref of a version-control source URL."""
    base, _, ref = url.partition("#")
    for prefix in ("git+", "hg+", "darcs+"):
        if base.startswith(prefix):
            base = base[len(prefix) :]
            break
    # The Nix sandbox has no SSH keys, so an SSH source is fetched over
    # HTTPS from the same host, which is the nix-purifiers convention.
    m = re.match(r"^(?:ssh://)?git@([^:/]+)[:/](.*)$", base)
    if m:
        base = f"https://{m.group(1)}/{m.group(2)}"
    return base, ref


def cache_url(checksum):
    kind, _, hexdigest = checksum.partition("=")
    return f"{OPAM_CACHE}/{kind}/{hexdigest[:2]}/{hexdigest}"


def cache_path(checksum):
    kind, _, hexdigest = checksum.partition("=")
    return f"download-cache/{kind}/{hexdigest[:2]}/{hexdigest}"


# ---------------------------------------------------------------------------
# The project.


def project_opam_files(root):
    """The project's own opam files, the ones `opam install ./` reads: the
    *.opam files and a file named `opam`, in the root and in opam/."""
    files = []
    for directory in (root, root / "opam"):
        if not directory.is_dir():
            continue
        for path in sorted(directory.iterdir()):
            if path.is_file() and (path.suffix == ".opam" or path.name == "opam"):
                files.append(path)
    return files


def package_name(root, path):
    if path.name == "opam":
        return OpamFile(path.read_text()).string("name") or root.name
    return path.name[: -len(".opam")]


def project_packages(root, only=()):
    """The project's packages, or the ones `only` names. A package outside
    `only` is not locked, built or installed."""
    packages = []
    for path in project_opam_files(root):
        if only and package_name(root, path) not in only:
            continue
        opam = OpamFile(path.read_text())
        packages.append(
            {
                "name": package_name(root, path),
                "version": opam.string("version") or "dev",
                "opamFile": str(path.relative_to(root)),
            }
        )
    if not packages:
        if only:
            fail(f"no opam file in {root} defines {', '.join(only)}")
        fail(f"no opam file in {root}; run opam-purifier in the project root")
    missing = set(only) - {p["name"] for p in packages}
    if missing:
        fail(f"no opam file in {root} defines {', '.join(sorted(missing))}")
    return packages


def definition_files(root):
    """The files that decide the lock: the project's opam files and the
    opam lock files beside them, sorted by path."""
    files = project_opam_files(root) + list(root.glob("*.opam.locked"))
    return sorted(files, key=lambda p: str(p.relative_to(root)))


def definition_hash(root, options):
    """The hash of what decides the lock: the SHA-256 of a manifest with a
    line `<path>\\t<sha256>` for each definition file, then the line
    `options\\t<options as compact JSON with sorted keys>`. nix/lib/lock.nix
    computes the same manifest, so the builder notices a stale lockfile."""
    lines = []
    for path in definition_files(root):
        lines.append(f"{path.relative_to(root)}\t{hashlib.sha256(path.read_bytes()).hexdigest()}\n")
    lines.append("options\t" + json.dumps(options, sort_keys=True, separators=(",", ":")) + "\n")
    return "sha256:" + hashlib.sha256("".join(lines).encode()).hexdigest()


def lock_hash(lock_data):
    """The hash a lockfile carries of its own content: the SHA-256 of the
    lockfile without `lockHash`, as compact JSON with sorted keys and
    UTF-8 text. builtins.toJSON writes the same text, so nix/lib/lock.nix
    notices a lockfile edited by hand."""
    content = {k: v for k, v in lock_data.items() if k != "lockHash"}
    text = json.dumps(content, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def write_lock(path, lock_data):
    lock_data["lockHash"] = lock_hash(lock_data)
    path.write_text(json.dumps(lock_data, indent=2, ensure_ascii=False) + "\n")


def read_lock(path):
    if not path.is_file():
        return None
    return json.loads(path.read_text())


# ---------------------------------------------------------------------------
# The lock run.


class LockRun:
    def __init__(self, root, options, work):
        self.root = root
        self.options = options
        self.work = work
        self.opam_root = work / "root"
        # Store paths of checkouts the lock run fetched itself, by entry path.
        self.checkouts = {}
        self.env = dict(os.environ)
        self.env.update(
            {
                "OPAMROOT": str(self.opam_root),
                "OPAMYES": "1",
                "OPAMNODEPEXTS": "1",
                "OPAMCOLOR": "never",
                "OPAMSTATUSLINE": "never",
                "OPAMNOENVNOTICE": "1",
                "OPAMCONFIRMLEVEL": "unsafe-yes",
                # The wrapper of the package names itself, since the
                # script it runs is not executable on its own.
                "OPAMFETCH": f"{os.environ.get('OPAM_PURIFIER_SELF', sys.argv[0])} fetch %{{url}}% %{{out}}%",
                "OPAM_PURIFIER_FETCH_LOG": str(work / "fetch.log"),
            }
        )
        # The lock run starts from opam's built-in configuration, whatever
        # the user's opam root holds.
        for key in ("OPAMSWITCH", "OPAM_SWITCH_PREFIX"):
            self.env.pop(key, None)

    def opam(self, *args, system=None, capture=False):
        env = dict(self.env)
        if system:
            env.update(platform_env(system))
        return run(["opam", *args], env=env, cwd=self.root, capture=capture)

    def pin(self, pins):
        """Pins the project's pin-depends before the solve, which then runs
        with --ignore-pin-depends."""
        for p in pins.values():
            if p["kind"] == "project":
                self.opam("pin", "add", "--no-action", "--kind=path", p["package"], str(self.root / p["path"]))
            elif p.get("path") in self.checkouts:
                copy = self.work / "pins" / p["package"]
                shutil.copytree(self.checkouts[p["path"]], copy)
                for item in [copy, *copy.rglob("*")]:
                    item.chmod(item.stat().st_mode | 0o200)
                self.opam("pin", "add", "--no-action", "--kind=path", p["package"], str(copy))
            else:
                self.opam("pin", "add", "--no-action", p["package"], p["url"])

    def install_args(self):
        args = ["--ignore-pin-depends"]
        if self.options["withTest"]:
            args.append("--with-test")
        if self.options["withDoc"]:
            args.append("--with-doc")
        if self.options["locked"]:
            args.append("--locked")
        return args

    def repository_source(self, repo):
        """Where opam reads a repository from. A URL `archive+<url>` names an
        archive of the repository, such as opam-repository at a commit on
        GitHub; the lock run unpacks it and gives opam the directory, so a
        relock reads the same repository state."""
        url = repo["url"]
        if not url.startswith("archive+"):
            return url
        archive = self.download(url[len("archive+") :])
        target = self.work / "repositories" / repo["name"]
        target.mkdir(parents=True)
        with tarfile.open(archive) as tar:
            members = tar.getmembers()
            tops = {m.name.split("/", 1)[0] for m in members}
            strip = len(tops) == 1
            for member in members:
                if strip:
                    if "/" not in member.name:
                        continue
                    member.name = member.name.split("/", 1)[1]
                if not member.name or member.issym() or member.islnk():
                    continue
                tar.extract(member, target, filter="data")
        if not (target / "repo").is_file():
            fail(f"{url}: the archive holds no opam repository (no `repo` file at its top)")
        return str(target)

    def init(self):
        repositories = self.options["repositories"]
        first = repositories[0]
        self.opam(
            "init", "--bare", "--disable-sandboxing", "--no-setup", first["name"], self.repository_source(first)
        )
        for repo in repositories[1:]:
            self.opam(
                "repository", "add", repo["name"], self.repository_source(repo), "--all-switches", "--set-default"
            )
        # The tools the lock holds for the interactive mode (--tool) take part
        # in the solution through a package that depends on them, so their
        # versions agree with the versions the project gets.
        self.tools_dir = None
        if self.options["tools"]:
            self.tools_dir = self.work / "tools"
            self.tools_dir.mkdir()
            depends = " ".join(f'"{t}"' for t in self.options["tools"])
            (self.tools_dir / f"{TOOLS_PACKAGE}.opam").write_text(
                f'opam-version: "2.0"\nname: "{TOOLS_PACKAGE}"\nversion: "1"\ndepends: [ {depends} ]\n'
            )
        switch = self.work / "switch"
        switch.mkdir()
        self.opam("switch", "create", str(switch), "--empty")
        self.env["OPAMSWITCH"] = str(switch)

    def solve(self, system, local_names):
        """The packages opam installs for the project and its tools on a
        system, as name.version strings, and the ones of them only the tools
        need. Their archives land in the download cache."""
        tools = [str(self.tools_dir / f"{TOOLS_PACKAGE}.opam")] if self.tools_dir else []
        args = ["install", "--deps-only", *self.install_args(), *self.targets, *tools]
        self.opam(*args, "--download-only", system=system)
        joint = self.dry_run(args, system, local_names, "joint")
        if not self.tools_dir:
            return joint, []
        project_args = ["install", "--deps-only", *self.install_args(), *self.targets]
        project_names = {p.partition(".")[0] for p in self.dry_run(project_args, system, local_names, "project")}
        tools_only = [p for p in joint if p.partition(".")[0] not in project_names]
        return [p for p in joint if p not in tools_only], tools_only

    def dry_run(self, args, system, local_names, label):
        solution_file = self.work / f"solution-{system}-{label}.json"
        self.opam(*args, "--dry-run", f"--json={solution_file}", system=system)
        solution = json.loads(solution_file.read_text())
        packages = []

        def walk(node):
            if isinstance(node, dict):
                for key in ("install", "upgrade", "downgrade", "reinstall"):
                    target = node.get(key)
                    if isinstance(target, dict) and "name" in target:
                        packages.append(target)
                for value in node.values():
                    walk(value)
            elif isinstance(node, list):
                for value in node:
                    walk(value)

        walk(solution.get("solution", []))
        return sorted(
            {
                f"{p['name']}.{p['version']}"
                for p in packages
                if p["name"] not in local_names
                and p["name"] != TOOLS_PACKAGE
                and not p["name"].startswith("deps-of-")
            }
        )

    def package_field(self, package, field, system=None):
        return self.opam("show", f"--field={field}", package, system=system, capture=True).strip()

    def raw_opam(self, package):
        return self.opam("show", "--raw", package, capture=True)

    def repository_entries(self, packages, pinned):
        """The repository files of the solved packages, as inline entries at
        their paths in a repository."""
        entries = {}
        for package in packages:
            name = package.partition(".")[0]
            if name in pinned:
                continue
            repo = self.package_field(package, "repository")
            archive = self.opam_root / "repo" / f"{repo}.tar.gz"
            directory = self.opam_root / "repo" / repo
            prefix = f"packages/{name}/{package}/"
            if archive.is_file():
                with tarfile.open(archive) as tar:
                    for member in tar.getmembers():
                        member_name = member.name.removeprefix("./")
                        if member.isfile() and member_name.startswith(prefix):
                            entries[member_name] = tar.extractfile(member).read()
            elif directory.is_dir():
                for path in (directory / prefix).rglob("*"):
                    if path.is_file():
                        entries[str(path.relative_to(directory))] = path.read_bytes()
            else:
                fail(f"cannot find repository {repo!r} of {package} under {self.opam_root / 'repo'}")
        result = []
        for path in sorted(entries):
            try:
                result.append({"path": path, "contents": entries[path].decode("utf-8")})
            except UnicodeDecodeError:
                fail(f"{path} in the repository is not UTF-8 text, and the lockfile keeps repository files as text")
        return result

    def cached_file(self, checksums):
        for checksum in checksums:
            path = self.opam_root / cache_path(checksum)
            if path.is_file():
                return path
        return None

    def download(self, url):
        target = self.work / "downloads" / hashlib.sha256(url.encode()).hexdigest()
        target.parent.mkdir(exist_ok=True)
        if not target.is_file():
            run(["curl", "-fsSL", "--retry", "2", "-o", str(target), url])
        return target

    def file_entry(self, source):
        """A file entry for an archive, at its path in opam's download cache
        when it has a checksum."""
        checksums = source["checksums"]
        path = self.cached_file(checksums) or self.download(source["src"])
        mirrors = list(source["mirrors"]) + [cache_url(c) for c in checksums]
        if checksums:
            entry_path = cache_path(checksums[0])
        else:
            entry_path = "urls/" + hashlib.sha256(source["src"].encode()).hexdigest()
        return {
            "path": entry_path,
            "url": source["src"],
            "mirrors": mirrors,
            "hash": sri_sha256(path.read_bytes()),
        }

    def vcs_entry(self, url, path):
        kind = vcs_of(url)
        fetch_url, ref = split_vcs(url)
        if kind == "git":
            rev = ref
            if not re.fullmatch(r"[0-9a-f]{40}", rev or ""):
                out = run(["git", "ls-remote", fetch_url, ref or "HEAD"], capture=True)
                lines = [line.split("\t") for line in out.splitlines() if line]
                if not lines:
                    fail(f"{url}: git cannot find {ref or 'HEAD'}")
                # A tag's peeled commit comes after the tag object.
                peeled = [line for line in lines if line[1].endswith("^{}")]
                rev = (peeled or lines)[0][0]
            # opam checks out a git source with its submodules.
            out = run(
                ["nix-prefetch-git", "--quiet", "--fetch-submodules", "--url", fetch_url, "--rev", rev],
                capture=True,
            )
            return {
                "path": path,
                # opam installs a pinned checkout by its files, so the
                # entry needs no .git and no commit object.
                "git": {
                    "url": fetch_url,
                    "rev": rev,
                    "submodules": True,
                    "leaveDotGit": False,
                    "commitObject": None,
                },
                "hash": json.loads(out)["hash"],
            }
        if kind == "hg":
            # A branch or tag moves, so the lock keeps the node it names now.
            rev = run(
                ["hg", "identify", "--rev", ref or "default", "--template", "{node}", fetch_url],
                capture=True,
            ).strip()
            out = run(["nix-prefetch-hg", fetch_url, rev], capture=True)
            nix32 = [line for line in out.splitlines() if line.strip()][-1].strip()
            sri = run(
                ["nix", "hash", "convert", "--hash-algo", "sha256", "--to", "sri", nix32], capture=True
            ).strip()
            # nix-prefetch-hg leaves subrepositories out by default.
            return {"path": path, "hg": {"url": fetch_url, "rev": rev, "subrepos": False}, "hash": sri}
        if kind == "darcs":
            # A tag names a Darcs state. Without one, opam takes the head,
            # and only a context file names that state, so the lock keeps
            # the context's text.
            # nix-prefetch-darcs hands darcs its clone options as one argument,
            # so it cannot clone by tag. The lock run clones the way nixpkgs'
            # fetchdarcs does and hashes the files without `_darcs`.
            checkout = self.work / "darcs" / path.replace("/", "_")
            checkout.parent.mkdir(exist_ok=True)
            cmd = ["darcs", "clone", "--lazy", "--quiet"]
            if ref:
                cmd.append(f"--tag={ref}")
            run([*cmd, fetch_url, str(checkout)])
            context = None
            if not ref:
                context = run(["darcs", "log", "--context", f"--repodir={checkout}"], capture=True)
            shutil.rmtree(checkout / "_darcs")
            hash_ = run(["nix", "hash", "path", "--type", "sha256", str(checkout)], capture=True).strip()
            # opam's own Darcs backend clones only `_darcs`, without the
            # files, so the lock run pins Darcs sources to this checkout.
            self.checkouts[path] = str(checkout)
            return {
                "path": path,
                "darcs": {"url": fetch_url, "rev": ref or None, "context": context},
                "hash": hash_,
            }
        fail(f"{url}: the lock cannot fetch {kind} sources")



def build_outputs(root, lock_path, local_names):
    """Builds the project's switch in the Nix sandbox from the lockfile
    written so far at lock_path, and reads the outputs from it: the files
    each local package installs, relative to the switch prefix."""
    out = run(nix_build(root, lock_path, "switch", ["--no-out-link"]), capture=True)
    switch = pathlib.Path(out.strip().splitlines()[-1])
    prefix = switch / "_opam"
    outputs = {}
    for name in local_names:
        listing = switch / "nix-support" / "opam-purifier-files" / name
        files = []
        for line in listing.read_text().splitlines():
            path = pathlib.Path(line.strip())
            if line.strip() and path.is_relative_to(prefix) and (path.is_file() or path.is_symlink()):
                files.append(str(path.relative_to(prefix)))
        outputs[name] = sorted(files)
    return outputs


def resolve_pins(root, lockrun, packages, downloads):
    """The pins: the pin-depends of the project's opam files, and of the
    pinned packages' own opam files."""
    pins = {}
    queue = []
    for p in packages:
        queue.extend(pin_depends_of((root / p["opamFile"]).read_text()))
    while queue:
        package, url = queue.pop(0)
        if package in pins:
            continue
        name = package.partition(".")[0]
        nested = None
        if url.startswith("file://") or not re.match(r"^[a-z+]+://", url):
            path = url.removeprefix("file://")
            full = (root / path).resolve()
            if not full.is_relative_to(root.resolve()):
                fail(f"pin-depends {package} points at {path}, outside the project")
            pins[package] = {"package": package, "name": name, "kind": "project", "path": str(full.relative_to(root.resolve()))}
            nested = full / f"{name}.opam" if (full / f"{name}.opam").is_file() else full / "opam"
        elif vcs_of(url):
            entry = lockrun.vcs_entry(url, f"sources/{package}")
            downloads[entry["path"]] = entry
            pins[package] = {"package": package, "name": name, "kind": "source", "path": entry["path"], "url": url}
        else:
            src, _, checksum = url.partition("#")
            entry = lockrun.file_entry({"src": src, "checksums": [checksum] if checksum else [], "mirrors": []})
            downloads[entry["path"]] = entry
            pins[package] = {"package": package, "name": name, "kind": "url", "url": src}
        if nested is not None and nested.is_file():
            queue.extend(pin_depends_of(nested.read_text()))
    return pins


def lock(root, lock_path, args):
    previous = read_lock(lock_path)
    if args.repo:
        repositories = []
        for spec in args.repo:
            name, sep, url = spec.partition("=")
            if not sep:
                fail(f"--repo {spec}: expected NAME=URL")
            repositories.append({"name": name, "url": url})
    elif previous:
        repositories = previous["options"]["repositories"]
    else:
        repositories = [{"name": DEFAULT_REPOSITORY[0], "url": DEFAULT_REPOSITORY[1]}]
    if args.tool is not None:
        tools = sorted(set(args.tool))
    elif previous:
        tools = previous["options"].get("tools", [])
    else:
        tools = []
    if args.only is not None:
        only = sorted(set(args.only))
    elif previous:
        only = previous["options"].get("only", [])
    else:
        only = []
    options = {
        "repositories": repositories,
        "only": only,
        "tools": tools,
        "withTest": not args.without_test,
        "withDoc": args.with_doc,
        "locked": any(root.glob("*.opam.locked")),
    }
    definition = definition_hash(root, options)
    packages = project_packages(root, options["only"])
    local_names = [p["name"] for p in packages]
    with tempfile.TemporaryDirectory(prefix="opam-purifier-") as tmp:
        lockrun = LockRun(root, options, pathlib.Path(tmp))
        # opam installs the project's packages by their opam files, so a lock
        # with --only leaves the others out.
        lockrun.targets = ["./" + p["opamFile"] for p in packages]
        lockrun.init()

        downloads = {}
        pins = resolve_pins(root, lockrun, packages, downloads)
        lockrun.pin(pins)

        systems = {}
        for system in SYSTEMS:
            print(f"opam-purifier: solving for {system}", file=sys.stderr)
            installs, tools = lockrun.solve(system, local_names)
            depexts = set()
            for package in installs + tools:
                depexts.update(d.strip('"') for d in lockrun.package_field(package, "depexts", system=system).split())
            systems[system] = {"install": installs, "tools": tools, "depexts": sorted(depexts)}
        all_packages = sorted({p for s in systems.values() for p in s["install"] + s["tools"]})

        pinned_names = {p["name"] for p in pins.values()}

        # The downloads of every solved package. A package whose source is
        # a version-control repository is installed from its checkout.
        for package in all_packages:
            name = package.partition(".")[0]
            if name in pinned_names:
                continue
            for source in sources_of(lockrun.raw_opam(package)):
                if vcs_of(source["src"]):
                    entry = lockrun.vcs_entry(source["src"], f"sources/{package}")
                    pins[package] = {"package": package, "name": name, "kind": "source", "path": entry["path"], "repository": True}
                else:
                    entry = lockrun.file_entry(source)
                downloads[entry["path"]] = entry

        repository = lockrun.repository_entries(all_packages, pinned_names)
        opam_version = run(["opam", "--version"], capture=True).strip()

    for p in packages:
        p["files"] = []
    lock_data = {
        "version": LOCK_VERSION,
        "opam": opam_version,
        "definitionHash": definition,
        "options": options,
        "packages": packages,
        "systems": systems,
        "pins": sorted(pins.values(), key=lambda p: p["package"]),
        "repository": repository,
        "downloads": [downloads[k] for k in sorted(downloads)],
    }
    # The lockfile so far goes outside the project until the build that
    # records the outputs succeeds, so a failed lock run leaves the
    # project's lockfile as it was.
    with tempfile.TemporaryDirectory(prefix="opam-purifier-lock-") as tmp:
        provisional = pathlib.Path(tmp) / LOCK_FILE
        write_lock(provisional, lock_data)
        print("opam-purifier: building the project in the Nix sandbox to record its outputs", file=sys.stderr)
        outputs = build_outputs(root, provisional, local_names)
    for p in packages:
        p["files"] = outputs.get(p["name"], [])
    write_lock(lock_path, lock_data)
    print(f"opam-purifier: wrote {lock_path} with {len(all_packages)} packages")


def fetch(url, out):
    """The download hook of the lock run (OPAMFETCH)."""
    log = os.environ.get("OPAM_PURIFIER_FETCH_LOG")
    if log:
        with open(log, "a") as f:
            f.write(f"{url}\t{out}\n")
    os.execvp("curl", ["curl", "-fsSL", "--retry", "2", "-o", out, url])


# ---------------------------------------------------------------------------
# The interactive mode.


def library():
    lib = os.environ.get("OPAM_PURIFIER_LIB")
    nixpkgs = os.environ.get("OPAM_PURIFIER_NIXPKGS")
    purifier = os.environ.get("OPAM_PURIFIER_PURIFIER")
    if not lib or not nixpkgs or not purifier:
        fail(
            "OPAM_PURIFIER_LIB, OPAM_PURIFIER_NIXPKGS and OPAM_PURIFIER_PURIFIER are unset; "
            "run opam-purifier from its Nix package"
        )
    return lib, nixpkgs, purifier


def current_system():
    machine = os.uname().machine
    for system in SYSTEMS:
        if system.split("-")[0] == machine:
            return system
    fail(f"this machine ({machine}) is not one of the systems a lock covers")


def nix_args(root, lock_path):
    """The arguments of nix/lib/cli.nix for the project at root."""
    _, nixpkgs, purifier = library()
    return [
        "--arg", "src", str(root),
        "--arg", "lockFile", str(lock_path),
        "--arg", "nixpkgs", nixpkgs,
        "--arg", "purifierSource", purifier,
        "--argstr", "system", current_system(),
    ]


def nix_build(root, lock_path, attr, extra):
    """A nix-build of an attribute of nix/lib/cli.nix. Nix checks the
    lockfile as it evaluates, and names the command that fixes it."""
    lib, _, _ = library()
    return ["nix-build", f"{lib}/cli.nix", "-A", attr, *nix_args(root, lock_path), *extra]


ENV_SCRIPT = """\
# The environment of the everyday loop, which `opam-purifier prefetch`
# writes. Source it from bash, or from an .envrc for direnv:
#
#   source .opam-purifier/env.sh
#
# The tools and system libraries of the sandboxed build come first, then
# the local switch _opam, on the opam root that holds only the locked
# packages.
source {shell_env}
export OPAMROOT={opam_root}
export OPAMSWITCH={root}
export OPAMFETCH="{state}/bin/offline-fetch %{{url}}% %{{out}}%"
export OPAMNODEPEXTS=1 OPAMNOENVNOTICE=1
eval "$({state}/loop-bin/opam env --shell=bash)"
export PATH={state}/loop-bin:"$PATH"
"""


def prefetch(root, lock_path):
    """Realizes, with garbage-collector roots under .opam-purifier, what
    the everyday loop needs: the offline state (the repository, the
    downloads and the tools' downloads), and the environment of the
    sandboxed build. It then sets up the local switch _opam from them, and
    writes .opam-purifier/env.sh."""
    lib, _, _ = library()
    state_dir = root / STATE_DIR
    state_dir.mkdir(exist_ok=True)
    state_link = state_dir / "state"
    print("opam-purifier: realizing the locked downloads", file=sys.stderr)
    run(nix_build(root, lock_path, "state", ["--out-link", str(state_link)]), capture=True)
    print("opam-purifier: realizing the environment of the build", file=sys.stderr)
    shell_env = run(
        [
            "nix", "print-dev-env",
            "--profile", str(state_dir / "shell-profile"),
            "--file", f"{lib}/cli.nix",
            *nix_args(root, lock_path),
            "shell",
        ],
        capture=True,
    )
    (state_dir / "shell-env").write_text(shell_env)
    # The root is made afresh from the lock each time, so it holds the
    # locked repository and download cache and nothing else.
    opam_root = state_dir / "root"
    for old in (opam_root, root / "_opam"):
        if old.exists():
            shutil.rmtree(old)
    env = dict(os.environ)
    env.update(
        {
            "OPAMROOT": str(opam_root),
            "OPAMYES": "1",
            "OPAMNODEPEXTS": "1",
            "OPAMCONFIRMLEVEL": "unsafe-yes",
            "OPAMNOENVNOTICE": "1",
            "OPAMFETCH": f"{state_link}/bin/offline-fetch %{{url}}% %{{out}}%",
        }
    )
    env.update(platform_env(current_system()))
    print("opam-purifier: installing the locked packages into _opam", file=sys.stderr)
    script = (
        f"source {shlex.quote(str(state_dir / 'shell-env'))} && "
        f"bash {shlex.quote(str(state_link))}/bin/install-dependencies {shlex.quote(str(root))} "
        f"{shlex.quote(str(root))} --with-tools"
    )
    run(["bash", "-c", script], env=env, cwd=root)
    (state_dir / "env.sh").write_text(
        ENV_SCRIPT.format(
            shell_env=shlex.quote(str(state_dir / "shell-env")),
            opam_root=shlex.quote(str(opam_root)),
            root=shlex.quote(str(root)),
            state=shlex.quote(str(state_link)),
        )
    )
    print(
        "opam-purifier: _opam holds the locked dependencies. Run `source .opam-purifier/env.sh` in bash, "
        "or put that line in .envrc for direnv, then `dune build` and `dune test`."
    )


# ---------------------------------------------------------------------------
# Publishing.


def publish(root, lock_path, args):
    lock_data = read_lock(lock_path)
    if lock_data is None:
        fail(f"no {lock_path}; run `opam-purifier lock` first")
    (root / STATE_DIR).mkdir(exist_ok=True)
    link = root / STATE_DIR / "release"
    run(nix_build(root, lock_path, "release", ["--out-link", str(link)]), capture=True)
    archive = next(link.resolve().iterdir())
    data = archive.read_bytes()
    sha256 = hashlib.sha256(data).hexdigest()
    sha512 = hashlib.sha512(data).hexdigest()
    print(f"opam-purifier: {archive}")
    print(f"  sha256={sha256}")
    print(f"  sha512={sha512}")
    if not args.url:
        print("opam-purifier: upload the archive, then run `opam-purifier publish --url URL` to submit it")
        return
    with urllib.request.urlopen(args.url) as response:
        served = response.read()
    if served != data:
        fail(f"{args.url} serves different bytes from the archive Nix built")
    # Every package of the project is released from the one archive.
    opam_texts = {}
    for entry in lock_data["packages"]:
        opam_text = (root / entry["opamFile"]).read_text()
        opam_texts[entry["name"]] = re.sub(r"(?ms)^url\s*\{.*?\}\s*", "", opam_text).rstrip() + (
            f'\nurl {{\n  src: "{args.url}"\n  checksum: [\n'
            f'    "sha256={sha256}"\n    "sha512={sha512}"\n  ]\n}}\n'
        )
    if args.repository:
        for entry in lock_data["packages"]:
            name = entry["name"]
            target = pathlib.Path(args.repository) / "packages" / name / f"{name}.{entry['version']}" / "opam"
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(opam_texts[name])
            print(f"opam-purifier: wrote {target}")
        print("opam-purifier: commit the opam files and open a pull request on the repository")
        return
    publisher = os.environ.get("OPAM_PURIFIER_OPAM_PUBLISH", "opam-publish")
    if shutil.which(publisher) is None:
        fail(f"{publisher} is not on PATH; pass --repository PATH to write the opam files into a checkout of the repository")
    with tempfile.TemporaryDirectory() as tmp:
        files = []
        for name, text in opam_texts.items():
            opam_file = pathlib.Path(tmp) / f"{name}.opam"
            opam_file.write_text(text)
            files.append(str(opam_file))
        run([publisher, args.url, *files])


# ---------------------------------------------------------------------------


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "fetch":
        fetch(sys.argv[2], sys.argv[3])
        return
    parser = argparse.ArgumentParser(prog="opam-purifier")
    sub = parser.add_subparsers(dest="command", required=True)
    commands = {}
    p = commands["lock"] = sub.add_parser("lock", help="solve the project and record every download")
    p.add_argument(
        "--repo",
        action="append",
        help="NAME=URL of a repository to resolve from; archive+URL names an archive of one",
    )
    p.add_argument(
        "--only",
        action="append",
        help="a package of the project to lock; the default is every package with an opam file",
    )
    p.add_argument(
        "--tool",
        action="append",
        help="a package for the everyday loop only, such as ocaml-lsp-server",
    )
    p.add_argument("--without-test", action="store_true", help="leave out test dependencies")
    p.add_argument("--with-doc", action="store_true", help="lock documentation dependencies too")
    commands["prefetch"] = sub.add_parser(
        "prefetch", help="realize what the everyday loop and the editor need, and set up _opam"
    )
    p = commands["publish"] = sub.add_parser(
        "publish", help="build the release archive and submit the opam files that point at it"
    )
    p.add_argument("--url", help="where the release archive is served")
    p.add_argument("--repository", help="a checkout of the opam repository to write the opam files into")
    for p in commands.values():
        p.add_argument(
            "--lockfile",
            help=f"the lockfile to write or read; the default is {LOCK_FILE} in the current directory",
        )
    args = parser.parse_args()
    root = pathlib.Path.cwd()
    lock_path = pathlib.Path(args.lockfile).resolve() if args.lockfile else root / LOCK_FILE
    if args.command == "lock":
        lock(root, lock_path, args)
    elif args.command == "prefetch":
        prefetch(root, lock_path)
    elif args.command == "publish":
        publish(root, lock_path, args)


if __name__ == "__main__":
    main()
